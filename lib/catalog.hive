// The games the arcade knows about. Each one's executable is published by its
// own repository's workflow as `<id>-<os>-<arch>[.exe]`, and the arcade's
// workflow packs those onto the end of the arcade under the same names. Each
// one's cover is `assets/games/<id>.png`, embedded with the rest of assets/.

type Game {
    id: Str
    title: Str
    tagline: Str
    blurb: Str
    tags: Str[dyn]
    controls: Str
    colour: Str
}

func games(): Game[3] {
    return [
        Game(
            "floreheim",
            "Floreheim",
            "Open-world crime in a city of bridges and beer halls",
            "Fly into Floreheim, a fictional city based on Blumenau. Then it's yours: half-timbered streets, iron bridges, a river and forested hills. Steal cars, take a plane up from the airfield, run jobs across town, or play with friends over the network. Just don't expect the police to give up easily.",
            ["Open world", "Action", "Driving", "Flying", "Multiplayer"],
            "WASD to move · Mouse to aim · E for cars · M for map",
            "#d9822b"
        ),
        Game(
            "formula-hive",
            "Formula Hive",
            "Kart racing with a Formula One face",
            "Ten cars, five teams, five laps. Drift through the corners to charge a boost, then let go to use it. You must pit once and run two tyre compounds, and the walls really stop you. Pick a quick race, a ten-round campaign or an online grid.",
            ["Racing", "Campaign", "Online", "Gamepad"],
            "Arrows to drive · Space to drift · E for pickups · Tab for standings",
            "#e0453a"
        ),
        Game(
            "panzer",
            "Hive Panzer",
            "Turn-based artillery on an island that won't last",
            "Build a tank block by block in the garage, then trade shells with the enemy. Read the wind, set the angle, hold for power. Every blast digs into the ground, and anything knocked into the sea is gone for good.",
            ["Strategy", "Turn-based", "Destructible", "Tank builder"],
            "WASD to drive · Mouse to aim · Hold Space to fire · 1–5 for weapons",
            "#6a9a3c"
        )
    ]
}

// The file a game's executable goes by, for this platform.
func fileFor(game: Game, platform: Str, suffix: Str): Str {
    return "{game.id}-{platform}{suffix}"
}

// The image a window draws for a file under assets/.
func asset(path: Str): Str {
    return "/_hive/asset/{path}"
}

func cover(game: Game): Str {
    return asset("games/{game.id}.png")
}
