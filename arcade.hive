// Hive Arcade
// ===========
// One window, every game, laid out like a launcher: the library down the left,
// the chosen game across the top of the page, every cover on a shelf below it.
// Press Play, Enter, or double-click a game, and it starts in a window of its
// own while the arcade stays open behind it.
//
// The games are not separate downloads. The arcade's CI build takes the latest
// release of each game's repository and packs the executables onto the end of
// the arcade's own (see lib/bundle.go and tools/bundle.py), so one file is the
// whole arcade. A game is written out to a folder of its own the first time it
// is played, and again only when the arcade carries a different build of it.
//
// Every start asks the arcade's public repository for its latest release, and
// if it is not this one, downloads it over this executable. The next start is
// the new arcade, with the new games in it — or press Restart when it says so.
//
// The covers are assets/games/<id>.png and the arcade's own icon is
// assets/icon.png; the build embeds all of assets/.
//
// RUN IT
//
//   hive run arcade.hive      a "dev" build: never updates, and finds games in
//                             a games/ folder beside it, named as released:
//                             floreheim-windows-amd64.exe and so on

import ./lib/bundle.go
import ./lib/catalog
import ./lib/updater
import ./lib/version

type Entry {
    game: catalog.Game
    file: Str
    present: Bool
    build: Str
}

type State {
    entries: Entry[dyn]
    chosen: Int
    status: Str
    failed: Bool
    update: Str
    canRestart: Bool
}

type Msg {
    Choose { index: Int }
    Launch { index: Int }
    Key { name: Str }
    Play
    Note { text: Str }
    Installed { tag: Str }
    Restart
}

// The palette. The arcade is dark whatever the desktop is, so every colour is
// written out rather than left to a role that follows the theme.
func chrome(): hive.ui.Tone {
    return ui.Tone.HEX("#0b0c10")
}

func page(): hive.ui.Tone {
    return ui.Tone.HEX("#12141a")
}

func panel(): hive.ui.Tone {
    return ui.Tone.HEX("#171a21")
}

func raised(): hive.ui.Tone {
    return ui.Tone.HEX("#262b38")
}

func hovered(): hive.ui.Tone {
    return ui.Tone.HEX("#1f232d")
}

func ink(): hive.ui.Tone {
    return ui.Tone.HEX("#eef0f5")
}

func faint(): hive.ui.Tone {
    return ui.Tone.HEX("#8b91a1")
}

func gold(): hive.ui.Tone {
    return ui.Tone.HEX("#e0b04a")
}

func go(): hive.ui.Tone {
    return ui.Tone.HEX("#3fa34d")
}

func caption(text: Str): hive.ui.View {
    return ui.text([ui.size(ui.TextSize.Caption()), ui.tone(faint())], text)
}

func heading(text: Str): hive.ui.View {
    return ui.text([ui.size(ui.TextSize.Caption()), ui.tone(gold())], text)
}

func chip(text: Str, fill: hive.ui.Tone): hive.ui.View {
    return ui.row([ui.pad(6), ui.background(fill)], [
        ui.text([ui.size(ui.TextSize.Caption()), ui.tone(ink())], text)
    ])
}

func cover(game: catalog.Game, side: Int): hive.ui.View {
    return ui.image([ui.width(side), ui.height(side)], catalog.cover(game), game.title)
}

func availability(entry: Entry): Str {
    if !entry.present {
        return "Not in this build"
    }
    if entry.build == "" {
        return "Ready · local copy"
    }
    return "Ready · {entry.build}"
}

func topBar(state: State): hive.ui.View {
    mut hive.ui.View action = ui.none()
    if state.canRestart {
        action = ui.button([ui.on(Msg.Restart()), ui.background(go()), ui.tone(ui.Tone.HEX("#ffffff")), ui.radius(6)], "Restart now")
    }
    return ui.row([ui.pad(12), ui.gap(12), ui.align(ui.Align.Center()), ui.background(chrome())], [
        ui.image([ui.width(36), ui.height(36)], catalog.asset("icon.png"), "Hive Arcade"),
        ui.text([ui.size(ui.TextSize.Subtitle()), ui.tone(ink())], "HIVE ARCADE"),
        ui.column([ui.width(12)], []),
        ui.text([ui.size(ui.TextSize.Caption()), ui.tone(gold())], "LIBRARY"),
        ui.spacer(),
        caption(state.update),
        action,
        chip("{len(state.entries)} GAMES", raised()),
        chip(version.current(), raised())
    ])
}

func sidebar(state: State): hive.ui.View {
    mut hive.ui.View[dyn] rows = []
    for i := 0; i < len(state.entries); i++ {
        if state.entries bounds i {
            entry := state.entries[i]
            mut hive.ui.Tone fill = panel()
            if i == state.chosen {
                fill = raised()
            }
            mut hive.ui.Tone nameTone = ink()
            if !entry.present {
                nameTone = faint()
            }
            append(rows, ui.row([
                ui.on(Msg.Choose(i)),
                ui.onDouble(Msg.Launch(i)),
                ui.background(fill),
                ui.hover(hovered()),
                ui.pad(8),
                ui.gap(12),
                ui.align(ui.Align.Center())
            ], [
                cover(entry.game, 40),
                ui.column([ui.gap(2), ui.grow(1)], [
                    ui.text([ui.tone(nameTone)], entry.game.title),
                    caption(availability(entry))
                ])
            ]))
        }
    }
    return ui.column([ui.width(270), ui.pad(14), ui.gap(4), ui.background(panel()), ui.scroll(ui.Axis.Vertical())], [
        heading("ALL GAMES"),
        ui.column([ui.height(6)], []),
        ui.column([ui.gap(2)], rows),
        ui.spacer(),
        caption("↑ ↓ to choose"),
        caption("Enter or double-click to play")
    ])
}

func shelf(state: State): hive.ui.View {
    mut hive.ui.View[dyn] cards = []
    for i := 0; i < len(state.entries); i++ {
        if state.entries bounds i {
            entry := state.entries[i]
            mut hive.ui.Tone fill = panel()
            if i == state.chosen {
                fill = raised()
            }
            append(cards, ui.column([
                ui.on(Msg.Choose(i)),
                ui.onDouble(Msg.Launch(i)),
                ui.width(150),
                ui.pad(12),
                ui.gap(8),
                ui.background(fill),
                ui.hover(hovered())
            ], [
                cover(entry.game, 126),
                ui.text([ui.tone(ink())], entry.game.title),
                caption(availability(entry))
            ]))
        }
    }
    return ui.column([ui.gap(10)], [
        heading("LIBRARY"),
        ui.row([ui.gap(14)], cards)
    ])
}

func hero(state: State, entry: Entry): hive.ui.View {
    mut hive.ui.View[dyn] tags = []
    for each tag in entry.game.tags {
        append(tags, chip(tag, ui.Tone.HEX("#00000055")))
    }
    mut Str label = "▶  PLAY"
    mut hive.ui.Tone button = go()
    if !entry.present {
        label = "UNAVAILABLE"
        button = raised()
    }
    mut hive.ui.Tone statusTone = faint()
    if state.failed {
        statusTone = ui.Tone.HEX("#ff7a6b")
    }
    return ui.row([ui.pad(22), ui.gap(26), ui.align(ui.Align.Center()), ui.background(ui.Tone.HEX("{entry.game.colour}30"))], [
        cover(entry.game, 168),
        ui.column([ui.gap(10), ui.grow(1)], [
            ui.text([ui.size(ui.TextSize.Title()), ui.heading(1), ui.tone(ink())], entry.game.title),
            ui.text([ui.size(ui.TextSize.Subtitle()), ui.tone(ui.Tone.HEX(entry.game.colour))], entry.game.tagline),
            ui.row([ui.gap(6)], tags),
            ui.column([ui.height(8)], []),
            ui.row([ui.gap(16), ui.align(ui.Align.Center())], [
                ui.button([
                    ui.on(Msg.Play()),
                    ui.disabled(!entry.present),
                    ui.background(button),
                    ui.hover(ui.Tone.HEX("#4dbb5c")),
                    ui.tone(ui.Tone.HEX("#ffffff")),
                    ui.radius(6),
                    ui.pad(14),
                    ui.width(200)
                ], label),
                ui.column([ui.gap(2)], [
                    caption(availability(entry)),
                    ui.text([ui.size(ui.TextSize.Caption()), ui.tone(statusTone)], state.status)
                ])
            ])
        ])
    ])
}

func details(state: State): hive.ui.View {
    at := state.chosen
    if state.entries bounds at {
        entry := state.entries[at]
        return ui.column([ui.grow(1), ui.gap(22), ui.pad(22), ui.background(page()), ui.scroll(ui.Axis.Vertical())], [
            hero(state, entry),
            ui.row([ui.gap(32)], [
                ui.column([ui.gap(8), ui.grow(2)], [
                    heading("ABOUT"),
                    ui.text([ui.tone(ink())], entry.game.blurb)
                ]),
                ui.column([ui.gap(8), ui.grow(1)], [
                    heading("CONTROLS"),
                    ui.text([ui.tone(faint())], entry.game.controls)
                ])
            ]),
            shelf(state)
        ])
    }
    return ui.column([ui.grow(1), ui.pad(32), ui.background(page())], [
        caption("No games in this arcade.")
    ])
}

func view(state: State): hive.ui.View {
    return ui.column([
        ui.grow(1),
        ui.background(page()),
        ui.keys(["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter"]),
        ui.onKey(Msg.Key(_))
    ], [
        topBar(state),
        ui.row([ui.grow(1), ui.align(ui.Align.Stretch())], [sidebar(state), details(state)])
    ])
}

proc start(state: mut State): void {
    at := state.chosen
    if state.entries bounds at {
        launch(state, state.entries[at])
    }
}

proc launch(state: mut State, entry: Entry): void {
    if !entry.present {
        return
    }
    Result.Ok(path) := bundle.prepare(entry.file, entry.game.id) else {
        Result.Error(why) {
            state.status = "Could not unpack {entry.game.title}: {why}"
            state.failed = true
            return
        }
    }
    if bundle.launch(path) is Result.Error(why) {
        state.status = "Could not start {entry.game.title}: {why}"
        state.failed = true
        return
    }
    state.status = "{entry.game.title} is starting…"
    state.failed = false
}

proc update(state: mut State, message: Msg): Msg {
    if message is Msg.Choose(index) {
        state.chosen = index
        state.status = ""
        state.failed = false
    } else if message is Msg.Launch(index) {
        state.chosen = index
        start(state)
    } else if message is Msg.Key(name) {
        if (name == "ArrowUp" || name == "ArrowLeft") && state.chosen > 0 {
            state.chosen = state.chosen - 1
            state.status = ""
        } else if (name == "ArrowDown" || name == "ArrowRight") && state.chosen < len(state.entries) - 1 {
            state.chosen = state.chosen + 1
            state.status = ""
        } else if name == "Enter" {
            start(state)
        }
    } else if message is Msg.Play {
        start(state)
    } else if message is Msg.Note(text) {
        state.update = text
    } else if message is Msg.Installed(tag) {
        state.update = "Hive Arcade {tag} is installed and opens next time."
        state.canRestart = true
    } else if message is Msg.Restart {
        if bundle.restart() is Result.Error(why) {
            state.update = "Could not restart: {why}"
        } else {
            hive.term.exit(0)
        }
    }
    return message
}

// Runs beside the window, and tells it what it found by posting to it.
proc watchForUpdates(window: Address<Msg>): void {
    current := version.current()
    if current == "dev" {
        async window(Msg.Note("Development build · updates off"))
        return
    }
    async window(Msg.Note("Checking for updates…"))
    check := updater.latest(version.repository(), current)
    if check is updater.Check.Newer(tag, url) {
        async window(Msg.Note("Downloading Hive Arcade {tag}…"))
        taken := updater.take(url)
        if taken is Result.Ok(_) {
            async window(Msg.Installed(tag))
        } else if taken is Result.Error(why) {
            async window(Msg.Note("Could not update to {tag}: {why}"))
        }
    } else if check is updater.Check.Failed(why) {
        async window(Msg.Note("Could not check for updates: {why}"))
    } else if check is updater.Check.Current {
        async window(Msg.Note("Hive Arcade {current} · up to date"))
    }
}

func entries(): Entry[dyn] {
    mut Entry[dyn] found = []
    for each game in catalog.games() {
        file := catalog.fileFor(game, bundle.platform(), bundle.suffix())
        append(found, Entry(game, file, bundle.has(file), bundle.note(file)))
    }
    return found
}

proc main(): void {
    bundle.cleanup()
    fresh := State(entries(), 0, "", false, "", false)
    if spawn(ui.window("Hive Arcade", view, update), fresh) is Result.Ok(window) {
        async watchForUpdates(window)
    }
}
